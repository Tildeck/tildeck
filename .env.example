# Copy to .env next to docker-compose.yml and fill in. Placeholder values
# only: real values never enter Git.
#
# Three kinds of variables live here:
# - Compose: read by docker compose itself while it reads the Compose file.
# - Bootstrap: read by the server before it can reach its database or decrypt
#   its stored settings. Environment only, by necessity.
# - Setting overrides: optional. Every one of these can instead be edited in
#   the admin panel. A value set here wins and locks the field in the panel.
#
# With APP_ENV=production (always, in docker-compose.yml) the server refuses
# to start while a bootstrap value is still a placeholder.

# --- Compose -----------------------------------------------------------------

# The release to run, for example 0.1.0. No default on purpose: an unset
# value must fail, never silently resolve to "latest".
TILDECK_VERSION=0.1.0
# Host interface and port the server is published on. The default loopback
# address is for a TLS reverse proxy on the same host; use 0.0.0.0 only when
# the proxy runs elsewhere and the network in between is trusted.
TILDECK_BIND=127.0.0.1
TILDECK_PORT=8080
# Production only: the host directory holding the PostgreSQL data files,
# writable by the postgres user of the container (UID 999). Development uses
# a named volume and ignores this value.
POSTGRES_DATA_DIR=./data/postgres

# --- Database ----------------------------------------------------------------

POSTGRES_DB=tildeck
POSTGRES_USER=tildeck
# Must match the password inside DATABASE_URL.
POSTGRES_PASSWORD=change-me

# --- Bootstrap ---------------------------------------------------------------

# Async SQLAlchemy URL. The host "postgres" is the Compose service.
DATABASE_URL=postgresql+asyncpg://tildeck:change-me@postgres:5432/tildeck
# development or production. docker-compose.yml forces production.
APP_ENV=development
# Encrypts the settings stored in the database. At least 32 characters.
# Losing it makes stored settings unreadable; keep a copy with your backups.
# Generate: openssl rand -base64 48
CONFIG_ENCRYPTION_KEY=change-me

# --- Setting overrides (optional) --------------------------------------------

# The https address clients and emails use to reach this server.
# PUBLIC_URL=https://sync.example.com
# Who may create an account: closed, invite, or open.
# REGISTRATION_MODE=closed
# Outgoing email. Without SMTP the server still works; see the self-hosting
# guide for what changes.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# starttls, tls, or none (none only for a relay on the same host or a private network).
# SMTP_SECURITY=starttls
# SMTP_USERNAME=tildeck@example.com
# SMTP_PASSWORD=change-me
# SMTP_FROM=tildeck@example.com
# Days a device may stay unused before it must sign in again.
# DEVICE_IDLE_DAYS=90
# Failed sign-in and recovery attempts per account, and account requests per
# client address, allowed in 15 minutes.
# SIGNIN_LIMIT_PER_ACCOUNT=10
# SIGNIN_LIMIT_PER_ADDRESS=30
