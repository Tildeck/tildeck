{
  "components": {
    "schemas": {
      "AccountView": {
        "properties": {
          "devices": {
            "items": {
              "$ref": "#/components/schemas/DeviceView"
            },
            "title": "Devices",
            "type": "array"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          },
          "locale": {
            "title": "Locale",
            "type": "string"
          }
        },
        "required": [
          "email",
          "email_verified",
          "locale",
          "devices"
        ],
        "title": "AccountView",
        "type": "object"
      },
      "ClaimRequest": {
        "properties": {
          "claim_token": {
            "maxLength": 100,
            "title": "Claim Token",
            "type": "string"
          },
          "device_id": {
            "title": "Device Id",
            "type": "string"
          }
        },
        "required": [
          "device_id",
          "claim_token"
        ],
        "title": "ClaimRequest",
        "type": "object"
      },
      "DeviceInfo": {
        "properties": {
          "id": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "DeviceInfo",
        "type": "object"
      },
      "DeviceView": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "current": {
            "title": "Current",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_seen_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "active",
              "revoked"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "created_at",
          "last_seen_at",
          "current"
        ],
        "title": "DeviceView",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorCode"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "database_unavailable",
          "unsupported_protocol",
          "registration_closed",
          "registration_needs_email",
          "registration_invite_required",
          "email_taken",
          "invalid_email",
          "invalid_credentials",
          "account_disabled",
          "unauthorized",
          "device_pending",
          "device_revoked",
          "device_not_found",
          "invalid_token",
          "token_expired",
          "recovery_failed",
          "rate_limited",
          "invalid_request",
          "email_unavailable",
          "email_not_verified"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "KdfParams": {
        "description": "Argon2id parameters chosen by the client; the server enforces the\nminimum of the security model and stores them for the next sign-in.",
        "properties": {
          "alg": {
            "pattern": "^argon2id13$",
            "title": "Alg",
            "type": "string"
          },
          "mem": {
            "maximum": 1073741824.0,
            "minimum": 67108864.0,
            "title": "Mem",
            "type": "integer"
          },
          "ops": {
            "maximum": 20.0,
            "minimum": 3.0,
            "title": "Ops",
            "type": "integer"
          },
          "salt": {
            "title": "Salt",
            "type": "string"
          }
        },
        "required": [
          "alg",
          "ops",
          "mem",
          "salt"
        ],
        "title": "KdfParams",
        "type": "object"
      },
      "Liveness": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Liveness",
        "type": "object"
      },
      "NewPassword": {
        "properties": {
          "auth_key": {
            "title": "Auth Key",
            "type": "string"
          },
          "kdf": {
            "$ref": "#/components/schemas/KdfParams"
          },
          "wrap_pw": {
            "$ref": "#/components/schemas/Sealed"
          }
        },
        "required": [
          "kdf",
          "auth_key",
          "wrap_pw"
        ],
        "title": "NewPassword",
        "type": "object"
      },
      "PasswordChange": {
        "properties": {
          "auth_key": {
            "title": "Auth Key",
            "type": "string"
          },
          "keep_other_devices": {
            "default": false,
            "title": "Keep Other Devices",
            "type": "boolean"
          },
          "new": {
            "$ref": "#/components/schemas/NewPassword"
          }
        },
        "required": [
          "auth_key",
          "new"
        ],
        "title": "PasswordChange",
        "type": "object"
      },
      "PreloginRequest": {
        "properties": {
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "PreloginRequest",
        "type": "object"
      },
      "PreloginResponse": {
        "properties": {
          "kdf": {
            "$ref": "#/components/schemas/KdfParams"
          }
        },
        "required": [
          "kdf"
        ],
        "title": "PreloginResponse",
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Database",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "RecoveryComplete": {
        "properties": {
          "device": {
            "$ref": "#/components/schemas/DeviceInfo"
          },
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          },
          "new": {
            "$ref": "#/components/schemas/NewPassword"
          },
          "recovery_auth_key": {
            "title": "Recovery Auth Key",
            "type": "string"
          }
        },
        "required": [
          "email",
          "recovery_auth_key",
          "new",
          "device"
        ],
        "title": "RecoveryComplete",
        "type": "object"
      },
      "RecoveryStart": {
        "properties": {
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          },
          "recovery_auth_key": {
            "title": "Recovery Auth Key",
            "type": "string"
          }
        },
        "required": [
          "email",
          "recovery_auth_key"
        ],
        "title": "RecoveryStart",
        "type": "object"
      },
      "RecoveryWrap": {
        "properties": {
          "vault_id": {
            "title": "Vault Id",
            "type": "string"
          },
          "wrap_rk": {
            "$ref": "#/components/schemas/Sealed"
          }
        },
        "required": [
          "vault_id",
          "wrap_rk"
        ],
        "title": "RecoveryWrap",
        "type": "object"
      },
      "RegisterRequest": {
        "properties": {
          "auth_key": {
            "title": "Auth Key",
            "type": "string"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceInfo"
          },
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          },
          "kdf": {
            "$ref": "#/components/schemas/KdfParams"
          },
          "locale": {
            "default": "en",
            "pattern": "^(en|he)$",
            "title": "Locale",
            "type": "string"
          },
          "recovery_auth_key": {
            "title": "Recovery Auth Key",
            "type": "string"
          },
          "vault_id": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Vault Id",
            "type": "string"
          },
          "wrap_pw": {
            "$ref": "#/components/schemas/Sealed"
          },
          "wrap_rk": {
            "$ref": "#/components/schemas/Sealed"
          }
        },
        "required": [
          "email",
          "vault_id",
          "kdf",
          "auth_key",
          "recovery_auth_key",
          "wrap_pw",
          "wrap_rk",
          "device"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "Sealed": {
        "description": "A nonce and a ciphertext, opaque to the server.",
        "properties": {
          "ct": {
            "title": "Ct",
            "type": "string"
          },
          "nonce": {
            "title": "Nonce",
            "type": "string"
          }
        },
        "required": [
          "nonce",
          "ct"
        ],
        "title": "Sealed",
        "type": "object"
      },
      "ServerInfo": {
        "properties": {
          "name": {
            "const": "tildeck",
            "title": "Name",
            "type": "string"
          },
          "protocol_version": {
            "title": "Protocol Version",
            "type": "integer"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "protocol_version"
        ],
        "title": "ServerInfo",
        "type": "object"
      },
      "SignedIn": {
        "description": "A device that may open the vault: its token and the wrapped key.",
        "properties": {
          "device_token": {
            "title": "Device Token",
            "type": "string"
          },
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          },
          "vault": {
            "$ref": "#/components/schemas/VaultKeys"
          }
        },
        "required": [
          "device_token",
          "email_verified",
          "vault"
        ],
        "title": "SignedIn",
        "type": "object"
      },
      "SigninRequest": {
        "properties": {
          "auth_key": {
            "title": "Auth Key",
            "type": "string"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceInfo"
          },
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email",
          "auth_key",
          "device"
        ],
        "title": "SigninRequest",
        "type": "object"
      },
      "SigninResult": {
        "description": "The answer to a sign-in: either the device is active (signed_in) or it\nwaits for approval (pending). One shape, so clients switch on status.",
        "properties": {
          "claim_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Claim Token"
          },
          "device_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          },
          "email_approval": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "An approval link was sent by email",
            "title": "Email Approval"
          },
          "signed_in": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SignedIn"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "active",
              "pending"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "SigninResult",
        "type": "object"
      },
      "VaultKeys": {
        "description": "What a device needs to open the vault with the master password.",
        "properties": {
          "kdf": {
            "$ref": "#/components/schemas/KdfParams"
          },
          "vault_id": {
            "title": "Vault Id",
            "type": "string"
          },
          "wrap_pw": {
            "$ref": "#/components/schemas/Sealed"
          }
        },
        "required": [
          "vault_id",
          "kdf",
          "wrap_pw"
        ],
        "title": "VaultKeys",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The Tildeck sync server API.",
    "title": "Tildeck",
    "version": "protocol-1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/account": {
      "get": {
        "operationId": "getAccount",
        "parameters": [
          {
            "in": "header",
            "name": "Tildeck-Protocol",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tildeck-Protocol"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountView"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not signed in"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid request"
          }
        },
        "summary": "Get Account",
        "tags": [
          "account"
        ]
      }
    },
    "/api/account/password": {
      "post": {
        "description": "Re-wraps the same vault key under a new master password. Every other\ndevice is signed out unless the user asks to keep them.",
        "operationId": "changePassword",
        "parameters": [
          {
            "in": "header",
            "name": "Tildeck-Protocol",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tildeck-Protocol"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Wrong current credentials"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid request"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many requests"
          }
        },
        "summary": "Change Password",
        "tags": [
          "account"
        ]
      }
    },
    "/api/account/prelogin": {
      "post": {
        "description": "The KDF parameters for an address. An address without an account gets\nstable made-up parameters, so the answer does not reveal which exist.",
        "operationId": "prelogin",
        "parameters": [
          {
            "in": "header",
            "name": "Tildeck-Protocol",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tildeck-Protocol"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreloginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreloginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid request"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many requests"
          }
        },
        "summary": "Prelogin",
        "tags": [
          "account"
        ]
      }
    },
    "/api/account/recovery/complete": {
      "post": {
        "description": "Sets a new master password with the recovery key, signs out every\ndevice, and signs in this one.",
        "operationId": "completeRecovery",
        "parameters": [
          {
            "in": "header",
            "name": "Tildeck-Protocol",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tildeck-Protocol"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoveryComplete"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedIn"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Wrong recovery key"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid request"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many requests"
          }
        },
        "summary": "Recovery Complete",
        "tags": [
          "account"
        ]
      }
    },
    "/api/account/recovery/start": {
      "post": {
        "description": "Proves the recovery key and returns the vault key wrapped by it.",
        "operationId": "startRecovery",
        "parameters": [
          {
            "in": "header",
            "name": "Tildeck-Protocol",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tildeck-Protocol"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoveryStart"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryWrap"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Wrong recovery key"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid request"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many requests"
          }
        },
        "summary": "Recovery Start",
        "tags": [
          "account"
        ]
      }
    },
    "/api/account/register": {
      "post": {
        "description": "Creates an account and signs in the registering device, which created\nthe vault. Syncing waits until the email address is confirmed.",
        "operationId": "register",
        "parameters": [
          {
            "in": "header",
            "name": "Tildeck-Protocol",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tildeck-Protocol"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedIn"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Registration is not open"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The address has an account"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
